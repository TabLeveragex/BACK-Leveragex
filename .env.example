PORT=8080

MONGO_CONN=your-mongodb-connection-string

JWT_SECRET=your-jwt-secret-min-32-chars

# Divine Pay (server-side only — never expose API key in frontend)
DIVINE_PAY_BASE_URL=https://divinepay.us.cc
DIVINE_PAY_API_KEY=your-divine-pay-secret-key
# Optional path overrides if gateway docs differ
# DIVINE_PAY_CREATE_PATH=/api/payin/payin/create
# DIVINE_PAY_STATUS_PATH=/api/payin/status

ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
ADMIN_NAME=LeverageX Admin

USER_DELETE_MODE=disabled

# Brevo (use API key for Render — SMTP ports are often blocked on cloud hosts)
BREVO_API_KEY=your-brevo-api-key
EMAIL_FROM=your-verified-sender@example.com

# Optional SMTP fallback
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-brevo-smtp-login@smtp-brevo.com
SMTP_PASS=your-brevo-smtp-key
